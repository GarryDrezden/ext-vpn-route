{
  "manifest_version": 3,
  "name": "VPN Route",
  "version": "1.0.0.18",
  "version_name": "1.0.0 RC18",
  "description": "Per-domain browser routing for VPN Route. Applies a generated PAC; does not run a VPN itself.",
  "key": "",
  "permissions": ["proxy", "storage", "alarms"],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VPN Route",
    "default_popup": "extension/popup/popup.html"
  }
}
