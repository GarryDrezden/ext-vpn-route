{
  "name": "ext-vpn-route",
  "version": "1.0.0-rc.16",
  "private": true,
  "description": "Browser side of VPN Route: per-domain routing for Chromium.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "measure:pac": "node scripts/measure-pac.js",
    "build:extension": "node scripts/build-extension.js",
    "build:extension:native": "node scripts/build-extension.js --mode=native",
    "build:extension:large": "node scripts/build-extension.js --fixture=large",
    "build:slice8-failclosed-fixture": "node scripts/build-slice8-failclosed-fixture.js",
    "build:native-host": "node scripts/build-native-host.js",
    "test:native-host": "dotnet test tests/native-host/SelectiveVpnRouter.NativeHost.Tests.csproj -c Release --nologo",
    "test:e2e": "node --test --test-timeout=600000 tests/e2e/service-native-host.e2e.js"
  }
}
